# Copier en .env et adapter. Les secrets ne vont jamais ici : voir scripts/init-secrets.sh.

# Nom du serveur sur le réseau local (DNS local ou fichier hosts des postes).
SITE_ADDRESS=mammomesh.lan
# Adresse d'écoute : l'adresse du serveur sur le réseau local (0.0.0.0 = toutes).
BIND_ADDRESS=0.0.0.0
# Premier administrateur, créé par le service migrate si aucun compte n'existe :
# mot de passe par défaut admin$1, à changer à la première connexion (voir scripts/init-secrets.sh).
ADMIN_USERNAME=admin
# Profils : obs (Prometheus + Grafana), backup (sauvegarde restic).
COMPOSE_PROFILES=
# Dossier de sauvegarde monté depuis l'hôte (disque ou NAS hors du serveur).
BACKUP_DIR=./backup
BACKUP_HOUR=2
LOG_LEVEL=info
MAMMOMESH_VERSION=dev
